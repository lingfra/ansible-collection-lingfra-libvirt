# ##############################################################################
#
# {{ ansible_managed }}
#
# /etc/conf.d/libvirt-guests
#
# See libvirt-guests(8) for more information.
#
# ##############################################################################


# Action taken on host boot.
ON_BOOT={{ libvirt_guests_ON_BOOT }}

# Number of seconds to wait between each guest start.
START_DELAY={{ libvirt_guests_START_DELAY }}

# Action to take on host shutdown.
ON_SHUTDOWN={{ libvirt_guests_ON_SHUTDOWN }}

# Number of guests will be shutdown concurrently, taking effect when
# "ON_SHUTDOWN" is set to "shutdown".
PARALLEL_SHUTDOWN={{ libvirt_guests_PARALLEL_SHUTDOWN }}

# Number of seconds we're willing to wait for a guest to shut down.
SHUTDOWN_TIMEOUT={{ libvirt_guests_SHUTDOWN_TIMEOUT }}

# If non-zero, try to bypass the file system cache when saving and restoring
# guests, even though this may give slower operation for some file systems.
BYPASS_CACHE={{ libvirt_guests_BYPASS_CACHE }}

# If non-zero, try to sync guest time on domain resume.
SYNC_TIME={{ libvirt_guests_SYNC_TIME }}

# Defines what type of guest virtual machine ON_SHUTDOWN action is applied to.
PERSISTENT_ONLY={{ libvirt_guests_PERSISTENT_ONLY }}
